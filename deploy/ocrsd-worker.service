[Unit]
Description=Worker OCRSD
After=network.target

[Service]
User=ocrsd
Group=ocrsd
WorkingDirectory=/opt/ocrsd
EnvironmentFile=/etc/ocrsd.env
Environment=OCRSD_STORAGE=/var/lib/ocrsd PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
ExecStart=/opt/ocrsd/.venv/bin/python -m src.web.worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=960
KillMode=mixed
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/ocrsd
MemoryMax=5G
CPUQuota=200%
TasksMax=128

[Install]
WantedBy=multi-user.target
