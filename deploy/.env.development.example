# Desenvolvimento local: Compose em 127.0.0.1:8080, volume ocrsd-dev_jobs.
#OCRSD_MAX_COUNT=10
OCRSD_MAX_UPLOAD_BYTES=12582912
OCRSD_MAX_PENDING=20
OCRSD_JOBS_PER_HOUR=10
OCRSD_RETENTION_HOURS=24
OCRSD_JOB_TIMEOUT=900
OCRSD_JOB_SECONDS_PER_DOCUMENT=30
OCRSD_MAX_JOB_BYTES=268435456
OCRSD_JOB_BYTES_PER_DOCUMENT=4194304
OCRSD_MAX_STORAGE_BYTES=4294967296
OCRSD_MIN_FREE_BYTES=536870912
OCRSD_MEMORY_MB=4096
OCRSD_NEURAL_ENABLED=true
OCRSD_ACCEPTING_JOBS=true
OCRSD_STANDARD_EDITS=false
OCRSD_HANDWRITING_ASSETS=./assets/handwriting
OCRSD_BIND_ADDRESS=127.0.0.1
OCRSD_HTTP_PORT=8080
# O Compose de desenvolvimento usa rede isolada; habilite IA somente com um
# endpoint local acessível pelos containers e uma configuração explícita.
OCRSD_AI_PROVIDER=none
#OCRSD_AI_PROVIDER=openai
#OCRSD_AI_BASE_URL=http://127.0.0.1:11434/v1
#OCRSD_AI_MODEL=qwen3:4b
#OCRSD_AI_TIMEOUT=60
#OCRSD_AI_RULES_CHARS=1800
#OCRSD_AI_MAX_FIELDS_PER_REQUEST=24
#OCRSD_AI_SECONDS_PER_DOCUMENT=120
