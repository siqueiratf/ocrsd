    given-names: "Tiago Faustino de"
    affiliation: "Universidade Federal de Santa Catarina"
repository-code: "https://github.com/siqueiratf/ocrsd"
url: "https://ocrsd.onrcpn.org.br"
license: MIT
version: "1.2.0"
date-released: "2026-11-06"
keywords:
